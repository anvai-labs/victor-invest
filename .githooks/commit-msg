#!/bin/bash
# Commit message hook for victor-invest
# Rejects any Co-Authored-By trailers in commit messages

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Colors for output
RED='\033[0;31m'
NC='\033[0m' # No Color

# Reject any Co-Authored-By trailer (case-insensitive)
if echo "$COMMIT_MSG" | grep -iqE "^[[:space:]]*co-authored-by:"; then
    echo -e "${RED}Commit message rejected:${NC}"
    echo -e "${RED}Contains a Co-Authored-By trailer.${NC}"
    echo ""
    echo "Co-Authored-By lines are not allowed in this repository."
    echo "Remove the trailer and try again."
    exit 1
fi

exit 0
