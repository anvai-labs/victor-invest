#!/bin/bash
# Pre-commit hook for victor-invest
# Runs ruff, black, and mypy checks before allowing commit

set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get list of staged Python files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "No Python files staged, skipping checks."
    exit 0
fi

echo "Staged Python files:"
echo "$STAGED_FILES"
echo ""

# Find Python 3.11+ (project minimum). Prefer python3.11, fall back to python3.
PYTHON="$(command -v python3.11 2>/dev/null || echo python3)"
PIP="$PYTHON -m pip"

# Verify critical project dependencies are installed; auto-install if missing
echo -e "${YELLOW}Checking project dependencies...${NC}"
MISSING_DEPS=""
for pkg in pandas numpy scipy sqlalchemy fastapi pydantic yaml ruff; do
    if [ "$pkg" = "ruff" ]; then
        command -v ruff >/dev/null 2>&1 || MISSING_DEPS="$MISSING_DEPS ruff"
    elif [ "$pkg" = "yaml" ]; then
        $PYTHON -c "import $pkg" 2>/dev/null || MISSING_DEPS="$MISSING_DEPS pyyaml"
    else
        $PYTHON -c "import $pkg" 2>/dev/null || MISSING_DEPS="$MISSING_DEPS $pkg"
    fi
done

# Also check dev tools
for tool in ruff black mypy; do
    command -v "$tool" >/dev/null 2>&1 || MISSING_DEPS="$MISSING_DEPS $tool"
done

if [ -n "$MISSING_DEPS" ]; then
    echo -e "${YELLOW}Missing dependencies:${MISSING_DEPS}${NC}"
    echo -e "${YELLOW}Auto-installing via '$PIP install -e .[dev,viz]'...${NC}"
    if $PIP install -e ".[dev,viz]" --quiet 2>&1; then
        echo -e "${GREEN}Dependencies installed successfully.${NC}"
    else
        echo -e "${RED}Auto-install failed. Run 'make dev-install' manually.${NC}"
        exit 1
    fi
fi
echo -e "${GREEN}Dependencies OK.${NC}"

# Run ruff checks (format + lint)
echo -e "${YELLOW}Running ruff format check...${NC}"
if ! ruff format --check $STAGED_FILES; then
    echo -e "${RED}Ruff format check failed. Run 'ruff format' to fix.${NC}"
    exit 1
fi
echo -e "${GREEN}Ruff format check passed.${NC}"

echo -e "${YELLOW}Running ruff lint...${NC}"
if ! ruff check $STAGED_FILES; then
    echo -e "${RED}Ruff lint failed. Run 'ruff check --fix' to attempt auto-fix.${NC}"
    exit 1
fi
echo -e "${GREEN}Ruff lint passed.${NC}"

# Run mypy as a ratchet rather than an absolute gate.
#
# This used to be `mypy <staged files>` with a zero-error requirement. The repo
# carries ~1,150 pre-existing errors and --follow-imports pulls in the whole
# closure, so it failed on every commit no matter what changed -- and the only
# way through was `git commit --no-verify`, which skips the ruff checks above
# too. A gate nobody can satisfy is a gate nobody runs.
#
# The ratchet compares per-file error counts against .mypy-baseline.json and
# fails only when a staged file gets worse.
echo -e "${YELLOW}Running mypy ratchet...${NC}"
MYPY_FILES=$(echo "$STAGED_FILES" | grep -E '^(src/|victor_invest/)' || true)
if [ -n "$MYPY_FILES" ]; then
    if ! python3 "$(git rev-parse --show-toplevel)/scripts/mypy_ratchet.py" --check $MYPY_FILES; then
        echo -e "${RED}Mypy ratchet failed: staged files added type errors.${NC}"
        exit 1
    fi
    echo -e "${GREEN}Mypy ratchet passed.${NC}"
else
    echo "No files in src/ or victor_invest/, skipping mypy."
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0
